{
  "routes": [
    {
      "route": "/editor",
      "rewrite": "/editor.html"
    },
    {
      "route": "/editor.html",
      "rewrite": "/editor.html"
    },
    {
      "route": "/admin",
      "rewrite": "/admin.html"
    },
    {
      "route": "/admin.html",
      "rewrite": "/admin.html"
    },
    {
      "route": "/banda",
      "rewrite": "/band.html"
    },
    {
      "route": "/banda/*",
      "rewrite": "/band.html"
    },
    {
      "route": "/band.html",
      "rewrite": "/band.html"
    },
    {
      "route": "/privacidade",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/privacy.html",
      "rewrite": "/privacy.html"
    },
    {
      "route": "/termos",
      "rewrite": "/terms.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms.html"
    },
    {
      "route": "/terms.html",
      "rewrite": "/terms.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/editor.html",
      "/editor/*",
      "/admin.html",
      "/admin/*",
      "/privacy.html",
      "/terms.html",
      "/*.{png,jpg,jpeg,gif,svg,ico,css,js,json}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Cache-Control": "no-cache"
  }
}