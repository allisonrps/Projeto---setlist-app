{
  "routes": [
    {
      "route": "/editor",
      "rewrite": "/web-editor/index.html"
    },
    {
      "route": "/web-editor",
      "rewrite": "/web-editor/index.html"
    },
    {
      "route": "/web-editor/*",
      "rewrite": "/web-editor/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/web-editor/assets/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,css,js,json}",
      "/web-editor/*.{png,jpg,jpeg,gif,svg,ico,css,js,json}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Cache-Control": "no-cache"
  }
}