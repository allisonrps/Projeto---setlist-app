{
  "expo": {
    "name": "BandLink",
    "slug": "allison-projects",
    "version": "1.3.6",
    "orientation": "portrait",
    "scheme": "bandlink",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.setlistbandmanager.com",
      "versionCode": 15,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para escanear o QR Code de sincronização do QR-PIN Share."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class expo.modules.** { *; }\n-keep class org.sqlite.** { *; }\n-dontwarn org.sqlite.**\n-keep class fr.greweb.reactnativeviewshot.** { *; }\n-dontwarn fr.greweb.reactnativeviewshot.**\n-keep class com.horcrux.svg.** { *; }\n-dontwarn com.horcrux.svg.**"
          }
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "e6952cda-4948-4c18-9fdd-a6ebb855e1b8"
      }
    },
    "owner": "allisonrpss-team"
  }
}
