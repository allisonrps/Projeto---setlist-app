{
  "routes": [
    {
      "route": "/editor",
      "rewrite": "/editor.html"
    },
    {
      "route": "/editor.html",
      "rewrite": "/editor.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/editor.html",
      "/editor/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,css,js,json}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*",
    "Cache-Control": "no-cache"
  }
}